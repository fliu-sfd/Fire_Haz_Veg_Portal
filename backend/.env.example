APP_NAME=Fire Hazardous Vegetation Portal API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
ENVIRONMENT=development

# Database (local docker-compose defaults)
DATABASE_URL=postgresql+psycopg://fhv:fhv_dev_pw@localhost:5432/fire_hazard_veg
TEST_DATABASE_URL=postgresql+psycopg://fhv:fhv_dev_pw@localhost:5432/fire_hazard_veg_test
DB_ECHO=false

# Auth (generate a real secret with: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_SECURE=false

# Frontend origins allowed to send cookies (JSON list)
CORS_ORIGINS=["http://localhost:3000"]
