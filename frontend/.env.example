# Public browser-visible URL; never put secrets in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Basemap tiles. Defaults to OpenStreetMap for development; set a production provider here.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
